<!--
    The open card lives in its own, fixed-size window that is always shown but fully
    transparent (and click-through) until the card opens. Because neither window is ever
    resized, Windows never blanks them: the notch can't flicker or vanish during transitions.
    Behaviour is wired up from MainWindow; CardWindow.xaml.cs only handles tabs and the wave.
-->
<Window x:Class="NotchApp.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotchApp"
        Title="Lagoon Card" Width="680" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Top bar tab: an icon with a small dot under it when selected -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="32" Height="30" Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="9" Margin="1,0,1,4" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                            <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{DynamicResource FgBrush}"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clipboard filter chip: All / Text / Links / ... -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChipOff}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ChipOnBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ChipOnFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Transport button (custom-drawn icons inside) -->
        <Style x:Key="Transport" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="20" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible slider laid over the wave: keeps native click/drag scrubbing -->
        <Style x:Key="GhostSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Opacity="0"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="CardIsland" Width="150" Height="32" Visibility="Hidden"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" CornerRadius="0,0,14,14" ClipToBounds="True">
          <Grid>
            <!-- touch: a grab handle to close the card (tap it, or swipe up anywhere) -->
            <Grid x:Name="CardHandle" Width="90" Height="16" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,2" Background="Transparent" Cursor="Hand" Panel.ZIndex="2" ToolTip="Close">
                <Border Width="40" Height="5" CornerRadius="2.5" Background="#59FFFFFF" VerticalAlignment="Center"/>
            </Grid>
            <!-- ===== A notification sliding out of the notch: tap to open the app, swipe up to dismiss ===== -->
            <Grid x:Name="NoticeView" Width="392" Height="62" Margin="0,12,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False" Background="Transparent" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="NoticeIcon" Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center" Background="#262628"/>
                <!-- Lagoon's own pop-outs: one action (Copy, Show in folder...) -->
                <Button x:Name="NoticeAction" Grid.Column="2" Style="{StaticResource CardButton}" Height="30" Padding="12,0"
                        VerticalAlignment="Center" Margin="4,0,2,0" Visibility="Collapsed">
                    <TextBlock x:Name="NoticeActionText" FontSize="12.5" FontWeight="SemiBold"/>
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                    <DockPanel>
                        <!-- on a call: the call timer stays visible here -->
                        <StackPanel x:Name="NoticeCall" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                            <Ellipse Width="6" Height="6" Fill="#FF9F0A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NoticeCallText" FontSize="12" FontWeight="SemiBold" Foreground="#FF9F0A" Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="NoticeMore" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Subtle}" Margin="8,0,0,0"/>
                        <TextBlock x:Name="NoticeApp" FontSize="12" Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="NoticeTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    <TextBlock x:Name="NoticeBody" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgBrush}" Opacity="0.85"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="ExpandedView" Width="568" Height="232" Margin="0,8,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== Top bar: tabs left, settings + palette right ===== -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <RadioButton x:Name="TabMedia" GroupName="tabs" Style="{StaticResource TabButton}"
                                 Content="&#xEC4F;" ToolTip="Now playing" IsChecked="True"/>
                    <RadioButton x:Name="TabClipboard" GroupName="tabs" Style="{StaticResource TabButton}"
                                 Content="&#xE77F;" ToolTip="Clipboard"/>
                    <RadioButton x:Name="TabWidgets" GroupName="tabs" Style="{StaticResource TabButton}"
                                 Content="&#xF0E2;" ToolTip="Widgets"/>
                    <RadioButton x:Name="TabTimer" GroupName="tabs" Style="{StaticResource TabButton}"
                                 Content="&#xE916;" ToolTip="Timer and stopwatch"/>
                    <RadioButton x:Name="TabAgents" GroupName="tabs" Style="{StaticResource TabButton}"
                                 Content="&lt;/&gt;" FontFamily="Cascadia Code, Consolas" FontWeight="Bold"
                                 FontSize="13" ToolTip="Claude Code"/>
                    <RadioButton x:Name="TabControls" GroupName="tabs" Style="{StaticResource TabButton}"
                                 Content="&#xE9E9;" ToolTip="Controls"/>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource SliderRestBrush}" Margin="2,0,8,4"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            Width="32" Height="26" FontSize="15" Foreground="{DynamicResource Subtle}"
                            ToolTip="Settings" Margin="0,0,0,4"/>
                </StackPanel>
                <Button x:Name="PaletteButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="30" Height="30" Cursor="Hand" Focusable="False" ToolTip="Switch theme" Margin="0,-2,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource Subtle}" Background="Transparent">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE790;" FontSize="14"
                                           Foreground="{DynamicResource FgBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ===== Timer tab: a countdown timer and a stopwatch, side by side ===== -->
                <Grid x:Name="TimerPage" Grid.Row="1" Margin="0,8,0,4" Visibility="Collapsed">
                    <Grid.Resources>
                        <Style x:Key="TimerAction" TargetType="Button" BasedOn="{StaticResource CardButton}">
                            <Setter Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- timer -->
                    <Border CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- time bubble: ‹ 25:00 › (the arrows step a minute) -->
                            <Border HorizontalAlignment="Center" CornerRadius="17" Height="34" Padding="2,0"
                                    Background="#1AFFFFFF" BorderBrush="#40FF9F0A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TimerMinus" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10"
                                            Content="&#xE76B;" ToolTip="1 minute less"/>
                                    <TextBlock x:Name="TimerBig" Text="25:00" FontSize="19" FontWeight="SemiBold" MinWidth="64" TextAlignment="Center"
                                               FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" Margin="2,0"/>
                                    <Button x:Name="TimerPlus" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10"
                                            Content="&#xE76C;" ToolTip="1 minute more"/>
                                </StackPanel>
                            </Border>
                            <!-- ruler: drag or scroll to set the length; follows the time left while running -->
                            <local:RulerPicker x:Name="TimerRuler" Grid.Row="1" Height="64" Margin="0,6,0,4" VerticalAlignment="Center"
                                               ToolTip="Drag to set the timer">
                                <local:RulerPicker.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="Black" Offset="0.12"/>
                                        <GradientStop Color="Black" Offset="0.88"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </local:RulerPicker.OpacityMask>
                            </local:RulerPicker>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TimerStart" Style="{StaticResource TimerAction}" Background="#33FF9F0A" ToolTip="Start / pause">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TimerStartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;"
                                                   FontSize="12" Foreground="#FF9F0A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TimerStartText" Text="Start" FontSize="13" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TimerReset" Grid.Column="2" Style="{StaticResource TimerAction}" ToolTip="Reset">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="12"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Subtle}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- stopwatch -->
                    <Border Grid.Column="2" CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Height="24">
                                <TextBlock Text="Stopwatch" FontSize="12.5" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock x:Name="LapsText" FontSize="12" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,4,0"/>
                            </DockPanel>
                            <TextBlock x:Name="StopwatchBig" Grid.Row="1" Text="00:00.0" FontSize="42" FontWeight="Light"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StopwatchStart" Style="{StaticResource TimerAction}" Background="#3330D158" ToolTip="Start / pause">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="StopwatchStartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;"
                                                   FontSize="12" Foreground="#30D158" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StopwatchStartText" Text="Start" FontSize="13" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopwatchLap" Grid.Column="2" Style="{StaticResource TimerAction}" ToolTip="Lap while running, reset while paused">
                                    <TextBlock x:Name="StopwatchLapText" Text="Lap" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Media tab ===== -->
                <Grid x:Name="MediaPage" Grid.Row="1" Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- artwork with a small badge on its corner -->
                    <Grid Width="128" Height="128">
                        <Border CornerRadius="26" Background="{DynamicResource Card}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEC4F;" FontSize="38"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ArtView" CornerRadius="26">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="ArtBadge" Width="38" Height="38" CornerRadius="12"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8"
                                Background="#E07FA0" BorderThickness="2.5" BorderBrush="#33000000">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEC4F;" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,8">
                        <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Text="Play something in any app" FontSize="15"
                                   Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- transport: drawn shapes, not font glyphs, for the chunky solid look -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Button x:Name="PrevButton" Style="{StaticResource Transport}" Opacity="0.55">
                            <Path Data="M13,0 L0,9 L13,18 Z M26,0 L13,9 L26,18 Z" Fill="{DynamicResource FgBrush}"
                                  StrokeLineJoin="Round" Stroke="{DynamicResource FgBrush}" StrokeThickness="1.5"/>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource Transport}" Width="48" Height="48" Margin="2,0">
                            <Grid>
                                <StackPanel x:Name="PauseGlyph" Orientation="Horizontal">
                                    <Rectangle Width="8" Height="28" RadiusX="2" RadiusY="2" Fill="{DynamicResource FgBrush}"/>
                                    <Rectangle Width="8" Height="28" RadiusX="2" RadiusY="2" Fill="{DynamicResource FgBrush}" Margin="7,0,0,0"/>
                                </StackPanel>
                                <Path x:Name="PlayGlyph" Data="M0,0 L22,14 L0,28 Z" Fill="{DynamicResource FgBrush}"
                                      Stroke="{DynamicResource FgBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                      Margin="4,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource Transport}" Opacity="0.55">
                            <Path Data="M0,0 L13,9 L0,18 Z M13,0 L26,9 L13,18 Z" Fill="{DynamicResource FgBrush}"
                                  StrokeLineJoin="Round" Stroke="{DynamicResource FgBrush}" StrokeThickness="1.5"/>
                        </Button>
                    </StackPanel>

                    <!-- wavy progress, times, volume -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="WaveHost" ClipToBounds="False">
                            <Rectangle x:Name="WaveRest" Height="2.5" RadiusX="1.25" RadiusY="1.25"
                                       Fill="{DynamicResource SliderRestBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Canvas x:Name="WaveClipHost" HorizontalAlignment="Left">
                                <Path x:Name="WavePath" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stroke="#E07FA0">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="WaveShift"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                            <Rectangle x:Name="WaveThumb" Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75"
                                       Fill="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Slider x:Name="ProgressSlider" Style="{StaticResource GhostSlider}" Minimum="0" Maximum="1"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock x:Name="ElapsedText" Text="0:00" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" FontSize="15"
                                           Foreground="{DynamicResource Subtle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider x:Name="VolumeSlider" Width="140" Style="{StaticResource PillSlider}"
                                        Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="RemainingText" Text="0:00" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== Clipboard tab (cards are built in code) ===== -->
                <Grid x:Name="ClipboardPage" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="ClipFilters" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Button x:Name="ClipClear" Style="{StaticResource IconButton}" Width="54" Height="28" FontSize="14"
                            FontFamily="{StaticResource UiFont}" Content="Clear" Foreground="{DynamicResource Subtle}"
                            HorizontalAlignment="Right" ToolTip="Clear history (pinned snippets stay)"/>
                    <ScrollViewer x:Name="ClipScroll" Grid.Row="1" Margin="0,6,0,4" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ScrollViewer.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="0.05"/><GradientStop Color="Black" Offset="0.95"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></ScrollViewer.OpacityMask>
                        <StackPanel x:Name="ClipList" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Copy text, a link, a picture or files and it shows up here."
                               Foreground="{DynamicResource Subtle}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="ClipNext" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="34" Height="34" Cursor="Hand" Focusable="False" Margin="0,0,-6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="17" Background="#E6202024" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="13" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ===== Widgets tab ===== -->
                <Grid x:Name="WidgetsPage" Grid.Row="1" Margin="0,8,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- clock + world clock -->
                    <Border CornerRadius="18" Background="{DynamicResource Card}" Padding="16,8,16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock x:Name="WClock" Text="8:24" FontSize="32" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <TextBlock x:Name="WAmPm" Text="AM" FontSize="14" FontWeight="SemiBold" Margin="5,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="WDay" Text="TUE" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            <Grid VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WCity" Text="London" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="WCityTime" Text="" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- weather -->
                    <Border Grid.Row="2" CornerRadius="18" Background="{DynamicResource Card}" Padding="16,8,16,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock x:Name="WWeatherIcon" FontFamily="{StaticResource IconFont}" Text="&#xE753;" FontSize="24" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WTemp" Text="--°" FontSize="30" FontWeight="SemiBold" Margin="10,0,0,0"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </StackPanel>
                            <Grid VerticalAlignment="Bottom">
                                <TextBlock x:Name="WCond" Text="Set a city in Settings" FontSize="13" Foreground="{DynamicResource Subtle}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                                <TextBlock x:Name="WHiLo" Text="" FontSize="13" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- to-do -->
                    <Border Grid.Column="2" CornerRadius="18" Background="{DynamicResource Card}" Padding="16,8,10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="To do" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WTodoCount" Text="" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="WTodoAdd" Style="{StaticResource IconButton}" Content="&#xE710;" Width="26" Height="26"
                                    FontSize="11" HorizontalAlignment="Right" ToolTip="Add a to-do"/>
                            <StackPanel x:Name="WTodoList" Grid.Row="1" Margin="0,4,0,0"/>
                            <TextBox x:Name="WTodoInput" Grid.Row="1" VerticalAlignment="Top" Margin="0,4,6,0" Visibility="Collapsed"
                                     Background="{DynamicResource ChipOff}" Foreground="{DynamicResource FgBrush}" BorderThickness="0"
                                     CaretBrush="{DynamicResource FgBrush}" Padding="6,3" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- battery -->
                    <Border Grid.Row="2" Grid.Column="2" CornerRadius="18" Background="{DynamicResource Card}" Padding="16,8,16,8">
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="WBattIcon" FontFamily="{StaticResource IconFont}" Text="&#xE83F;" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="This PC" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid Width="70" Height="6" VerticalAlignment="Center">
                                        <Border CornerRadius="3" Background="{DynamicResource SliderRestBrush}"/>
                                        <Border x:Name="WBattBar" CornerRadius="3" Background="#30D158" HorizontalAlignment="Left" Width="70"/>
                                    </Grid>
                                    <TextBlock x:Name="WBattText" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#30D158"
                                               Margin="12,0,0,0" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <!-- "Full in 1h 05m" / "4h 20m left", and battery saver (tap to switch) -->
                            <Grid x:Name="WBattDetailRow" Margin="0,4,0,0">
                                <TextBlock x:Name="WBattDetail" FontSize="12.5" Foreground="{DynamicResource Subtle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                                <Border x:Name="WSaver" HorizontalAlignment="Right" CornerRadius="10" Height="20" Padding="8,0,9,0"
                                        Background="{DynamicResource ChipOff}" Cursor="Hand" ToolTip="Battery saver">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="WSaverIcon" FontFamily="{StaticResource IconFont}" Text="&#xEBC0;" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="WSaverText" Text="Saver off" FontSize="11.5" FontWeight="SemiBold"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- connected Bluetooth headphones that report their battery (hidden when none) -->
                            <Grid x:Name="WBudsRow" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F6;" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WBudsName" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                               MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Grid Width="70" Height="6" VerticalAlignment="Center">
                                        <Border CornerRadius="3" Background="{DynamicResource SliderRestBrush}"/>
                                        <Border x:Name="WBudsBar" CornerRadius="3" Background="#30D158" HorizontalAlignment="Left" Width="70"/>
                                    </Grid>
                                    <TextBlock x:Name="WBudsText" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#30D158"
                                               Margin="12,0,0,0" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Claude Code tab (rows are built in code) ===== -->
                <Grid x:Name="AgentsPage" Grid.Row="1" Margin="0,4,0,4" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="AgentSummary" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Button x:Name="AgentClear" Style="{StaticResource IconButton}" Width="54" Height="26" FontSize="13"
                            FontFamily="{StaticResource UiFont}" Content="Clear" Foreground="{DynamicResource Subtle}"
                            HorizontalAlignment="Right" ToolTip="Remove finished sessions"/>
                    <ScrollViewer x:Name="AgentScroll" Grid.Row="1" Margin="0,4,0,0" Focusable="False"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="AgentList"/>
                    </ScrollViewer>
                    <StackPanel x:Name="AgentEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentEmptyText" Text="Connect Claude Code to see your sessions here."
                                   Foreground="{DynamicResource Subtle}" FontSize="13" HorizontalAlignment="Center"/>
                        <Button x:Name="AgentConnect" Style="{StaticResource CardButton}" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Connect Claude Code" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Controls tab ===== -->
                <Grid x:Name="ControlsPage" Grid.Row="1" Margin="0,8,0,4" Visibility="Collapsed">
                    <!-- two rows shared by both sides, so everything lines up -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <!-- clock + date (+ who's using the mic/camera) -->
                    <Border CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="18,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Text="00:00" FontSize="38" FontWeight="Light"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Margin="-2,-6,0,0"/>
                            <TextBlock x:Name="DateText" Text="" FontSize="14" Foreground="{DynamicResource Subtle}" Margin="1,-2,0,0"/>
                            <StackPanel x:Name="PrivacyStatus" Orientation="Horizontal" Margin="1,6,0,0" Visibility="Collapsed">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" FontSize="12" Margin="6,0,0,0" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- quick toggles -->
                    <Border Grid.Column="2" CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="12,0">
                        <UniformGrid Columns="4" VerticalAlignment="Center">
                            <ToggleButton x:Name="WifiToggle" Style="{StaticResource Chip}" Content="&#xE701;" ToolTip="Wi-Fi" Width="52" Height="52" Margin="0"/>
                            <ToggleButton x:Name="BluetoothToggle" Style="{StaticResource Chip}" Content="&#xE702;" ToolTip="Bluetooth" Width="52" Height="52" Margin="0"/>
                            <ToggleButton x:Name="MuteToggle" Style="{StaticResource Chip}" Content="&#xE74F;" ToolTip="Mute sound" Width="52" Height="52" Margin="0"/>
                            <ToggleButton x:Name="MicToggle" Style="{StaticResource DangerChip}" Content="&#xE720;" ToolTip="Mute microphone (Ctrl+Alt+M)" Width="52" Height="52" Margin="0"/>
                        </UniformGrid>
                    </Border>

                    <!-- focus timer: same row as brightness -->
                    <Border Grid.Row="2" CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FocusButton" Style="{StaticResource CardButton}" Background="Transparent" ToolTip="Start / pause a focus session">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FocusIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;"
                                               FontSize="12" Foreground="#FF9F0A" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FocusText" Text="Focus 25:00" FontSize="13" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FocusResetButton" Grid.Column="2" Style="{StaticResource CardButton}" Background="Transparent" ToolTip="Reset timer">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="12"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource Subtle}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- brightness -->
                    <Border Grid.Row="2" Grid.Column="2" CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE706;" FontSize="15"
                                       Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                    Minimum="0" Maximum="100"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
          </Grid>
        </Border>
    </Grid>
</Window>
