<!--
    The resting notch: thin line, pill and toasts. A fixed small window that is never
    resized (the open card is a separate window, see CardWindow.xaml).
-->
<Window x:Class="NotchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lagoon" Width="380" Height="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">
    <Grid>
        <Border x:Name="Island" Width="150" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" CornerRadius="0,0,14,14" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_Click">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="DndMenu" Header="Do not disturb" IsCheckable="True" Click="Dnd_Click"/>
                    <MenuItem Header="Settings…" Click="Settings_Click"/>
                    <Separator/>
                    <MenuItem Header="Quit Lagoon" Click="Quit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- ===== Compact pill ===== -->
                <Grid x:Name="CompactView" Height="32" VerticalAlignment="Top" Margin="12,0">
                    <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- do not disturb is on -->
                        <TextBlock x:Name="CompactDnd" FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12"
                                   Foreground="#BF5AF2" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                                   ToolTip="Do not disturb"/>
                        <!-- Caps Lock is on -->
                        <TextBlock x:Name="CompactCaps" Text="&#x21EA;" FontFamily="Segoe UI Symbol" FontSize="13"
                                   Foreground="#FF9F0A" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                                   ToolTip="Caps Lock is on"/>
                        <TextBlock x:Name="CompactMic" FontFamily="{StaticResource IconFont}" Text="&#xE720;"
                                   Foreground="#FF453A" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <!-- privacy dots: camera green, mic orange, screen capture blue -->
                        <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="5,0,0,0" Visibility="Collapsed">
                            <Ellipse x:Name="DotCamera" Width="7" Height="7" Fill="#30D158" Margin="3,0,0,0" Visibility="Collapsed"/>
                            <Ellipse x:Name="DotMic" Width="7" Height="7" Fill="#FF9F0A" Margin="3,0,0,0" Visibility="Collapsed"/>
                            <Ellipse x:Name="DotScreen" Width="7" Height="7" Fill="#0A84FF" Margin="3,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="CallTimer" Foreground="#FF9F0A" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CompactTimer" Foreground="#FF9F0A" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CompactStopwatch" Foreground="#30D158" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="EqBars" Orientation="Horizontal" Height="16" VerticalAlignment="Center"
                                    Margin="8,0,0,0" Visibility="Collapsed">
                            <Rectangle Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                            <Rectangle Width="3" Height="9" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                            <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                            <Rectangle Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="White"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Toast (mic muted, timer done...) ===== -->
                <StackPanel x:Name="ToastView" Orientation="Horizontal" Height="38" VerticalAlignment="Top"
                            HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
