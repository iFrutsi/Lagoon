<Window x:Class="NotchApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lagoon Settings" Width="480" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#161618" Foreground="White"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#232326"/>
        <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>

        <!-- Backdrop used in the previews so translucency shows -->
        <LinearGradientBrush x:Key="PreviewBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5E5CE6" Offset="0"/>
            <GradientStop Color="#BF5AF2" Offset="0.5"/>
            <GradientStop Color="#FF9F0A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <Border x:Name="Frame" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent"
                                    Background="{StaticResource Panel}" Padding="3">
                                <ContentPresenter/>
                            </Border>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#48484A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- the knob slides (ease-in-out, a move) and stretches 12% mid-way, like a drop of liquid -->
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#3A3A3C">
                            <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10" Background="White" Margin="2,0"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="18" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Knob" Storyboard.TargetProperty="Width">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.11" Value="22.4"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="20"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Knob" Storyboard.TargetProperty="Width">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.11" Value="22.4"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="20"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#3A3A3C" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#48484A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
    <StackPanel Margin="24,18,24,24">
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"
                   FontFamily="Segoe UI Variable Display, Segoe UI"/>

        <!-- ===== Appearance ===== -->
        <TextBlock Text="THEME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,22,0,10"/>
        <UniformGrid Columns="2" Margin="0,0,-10,0">
            <RadioButton x:Name="ThemeBlack" GroupName="theme" Tag="Black" Style="{StaticResource ThemeCard}" Checked="Theme_Checked">
                <Border CornerRadius="11" Height="74" Background="{StaticResource PreviewBackdrop}" ClipToBounds="True">
                    <Border Width="96" Height="24" VerticalAlignment="Top" CornerRadius="0,0,11,11" Background="Black">
                        <Grid Margin="8,0">
                            <Border Width="13" Height="13" CornerRadius="4" Background="#FF9F0A" HorizontalAlignment="Left"/>
                            <TextBlock Text="12:30" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>
            </RadioButton>
            <RadioButton x:Name="ThemeGlass" GroupName="theme" Tag="Glass" Style="{StaticResource ThemeCard}" Checked="Theme_Checked">
                <Border CornerRadius="11" Height="74" Background="{StaticResource PreviewBackdrop}" ClipToBounds="True">
                    <Border Width="96" Height="24" VerticalAlignment="Top" CornerRadius="0,0,11,11" BorderThickness="1,0,1,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B8121215" Offset="0"/>
                                <GradientStop Color="#8A1C1C22" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#5CFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid Margin="8,0">
                            <Border Width="13" Height="13" CornerRadius="4" Background="#FF9F0A" HorizontalAlignment="Left"/>
                            <TextBlock Text="12:30" FontSize="10" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>
            </RadioButton>
        </UniformGrid>
        <TextBlock Text="Glass is a see-through tint with a soft highlight along its curve, so your wallpaper shows through."
                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,12,0,0"/>

        <!-- ===== Dock ===== -->
        <TextBlock Text="DOCK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,24,0,10"/>
        <Border CornerRadius="12" Background="{StaticResource Panel}" Padding="16,12">
            <StackPanel>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                        <TextBlock Text="Floating dock" FontSize="14"/>
                        <TextBlock Text="Start, your apps, music, timer, quick settings and the clock in a bar along the bottom"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <CheckBox x:Name="DockSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Click="Dock_Click"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                        <TextBlock Text="Hide the Windows taskbar" FontSize="14"/>
                        <TextBlock Text="Sets it to auto-hide while the dock is on, and puts it back when you turn the dock off or quit"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <CheckBox x:Name="HideTaskbarSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Click="Dock_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Notifications ===== -->
        <TextBlock Text="NOTIFICATIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,24,0,10"/>
        <Border CornerRadius="12" Background="{StaticResource Panel}" Padding="16,12">
            <StackPanel>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                        <TextBlock Text="Notifications through the notch" FontSize="14"/>
                        <TextBlock Text="New notifications slide out of the notch instead of Windows' pop-ups. Windows' pop-ups come back when you turn this off or quit"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <CheckBox x:Name="NotesSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Click="Notes_Click"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                        <TextBlock Text="Do not disturb" FontSize="14"/>
                        <TextBlock Text="Nothing pops out; notifications wait in the notification centre. Also in the notch's right-click menu"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <CheckBox x:Name="DndSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Click="Notes_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Widgets ===== -->
        <TextBlock Text="WIDGETS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,24,0,10"/>
        <Border CornerRadius="12" Background="{StaticResource Panel}" Padding="16,12">
            <StackPanel>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Weather city" FontSize="14"/>
                        <TextBlock Text="Only the city name is sent to Open-Meteo" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <TextBox x:Name="WeatherCityBox" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Background="#3A3A3C" Foreground="White" BorderThickness="0" Padding="8,5" CaretBrush="White"
                             LostFocus="WeatherCity_LostFocus"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="World clock" FontSize="14" VerticalAlignment="Center"/>
                    <ComboBox x:Name="WorldCityBox" Width="150" HorizontalAlignment="Right" SelectionChanged="WorldCity_Changed"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Claude Code ===== -->
        <TextBlock Text="CLAUDE CODE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,24,0,10"/>
        <Border CornerRadius="12" Background="{StaticResource Panel}" Padding="16,12">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                    <TextBlock Text="Show Claude Code sessions" FontSize="14"/>
                    <TextBlock x:Name="ClaudeHint" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                               Text="Adds small hooks to your Claude Code settings that tell the notch what each session is doing. Nothing leaves your PC."/>
                </StackPanel>
                <CheckBox x:Name="ClaudeSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Click="Claude_Click"/>
            </Grid>
        </Border>

        <!-- ===== General ===== -->
        <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,24,0,10"/>
        <Border CornerRadius="12" Background="{StaticResource Panel}" Padding="16,12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" FontSize="14"/>
                    <TextBlock Text="Open the notch automatically when you sign in" FontSize="12" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Click="Startup_Click"/>
            </Grid>
        </Border>

        <Grid Margin="0,20,0,0">
            <TextBlock Text="Ctrl+Alt+M mutes the microphone everywhere" FontSize="12"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <Button Content="Quit Lagoon" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Click="Quit_Click"/>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
